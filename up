from __future__ import annotations

import argparse
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

try:
    from rich import box
    from rich.console import Console
    from rich.panel import Panel
    from rich.table import Table
except ModuleNotFoundError:
    box = None
    Console = None
    Panel = None
    Table = None


SESSION = "lm-based"
ROOT = Path(__file__).resolve().parent
RUNTIME = ROOT / ".runtime" / "tmux"
SHIM = ROOT / "support" / "tmux-service-shim"
console = Console() if Console is not None else None


@dataclass(frozen=True)
class Service:
    name: str
    command: str
    description: str
    deps: tuple[str, ...] = ()
    window: str | None = None
    env: dict[str, str] = field(default_factory=dict)

    @property
    def window_name(self) -> str:
        return self.window or self.name


@dataclass(frozen=True)
class Plan:
    target: str
    services: tuple[Service, ...]


@dataclass(frozen=True)
class WindowState:
    name: str
    dead: bool
    pid: int


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Manage lm-based services in a tmux session.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Targets may be service sets, service names, or model slugs.\n"
            "\n"
            "Examples:\n"
            "  ./up\n"
            "  ./up direct\n"
            "  ./up swap\n"
            "  ./up qwen36-27b-mtp-ud-q5k-xl\n"
            "  ./up qwen36-27b-mtp-ud-q5k-xl --restart\n"
            "  ./up --status\n"
            "  ./up --down\n"
            "  ./up dashboard --attach\n"
        ),
    )
    parser.add_argument("target", nargs="?", default="core", help="service-set, service-name, or model slug")
    parser.add_argument("--list", action="store_true", help="list known targets")
    parser.add_argument("--dry-run", action="store_true", help="print resolved services without starting tmux")
    parser.add_argument("--attach", action="store_true", help="attach to the tmux session after starting")
    lifecycle = parser.add_mutually_exclusive_group()
    lifecycle.add_argument("--down", action="store_true", help="stop the entire tmux service session")
    lifecycle.add_argument("--status", action="store_true", help="show current tmux service state")
    lifecycle.add_argument("--restart", action="store_true", help="restart target services that are already running")
    lifecycle.add_argument("--no-restart", action="store_false", dest="restart", default=False, help=argparse.SUPPRESS)
    parser.add_argument("--add", action="store_true", help="preserve service windows outside the selected target")
    parser.add_argument("--session", default=SESSION, help="tmux session name")
    args = parser.parse_args(argv)

    if args.down:
        return stop_session(args.session)
    if args.status:
        return print_status(args.session)

    registry = build_registry()
    if args.list:
        print_targets(registry)
        return 0

    try:
        plan = resolve_target(args.target, registry)
    except KeyError as exc:
        print_error(f"unknown target {exc.args[0]!r}")
        print("run ./up --list to see service sets, services, and model slugs", file=sys.stderr)
        return 2

    if args.dry_run:
        print_plan(plan, args.session)
        return 0

    if shutil.which("tmux") is None:
        print_error("tmux is not installed or not on PATH")
        print("install tmux, then rerun this command", file=sys.stderr)
        return 1

    if not SHIM.exists():
        print_error(f"missing service shim: {SHIM.relative_to(ROOT)}")
        return 1

    ensure_session(args.session)
    if not args.add:
        reconcile_windows(args.session, plan)
    actions: dict[str, str] = {}
    for service in plan.services:
        actions[service.name] = start_service(
            args.session,
            service,
            restart=args.restart,
        )

    print_ensured(plan, args.session, actions)

    if args.attach:
        return subprocess.call(["tmux", "attach", "-t", args.session])
    return 0


def build_registry() -> dict[str, Service | tuple[str, ...]]:
    services: dict[str, Service | tuple[str, ...]] = {
        "stats-poll": Service(
            name="stats-poll",
            window="stats",
            description="poll llama-server metrics and write rolling stats JSON",
            command=(
                "GOCACHE=/tmp/go-build go run ./cmd/serve-manager stats-poll "
                "--interval 500ms "
                "--window 1s "
                "--bucket 10s "
                "--retention 1h "
                "--trend-recent 5m "
                "--trend-points 1440 "
                "--timeout 20s "
                "--url http://127.0.0.1:8001 "
                "--output .runtime/serve-manager/stats/llama-server.json"
            ),
        ),
        "dashboard": Service(
            name="dashboard",
            description="serve embedded model-performance dashboard",
            deps=("stats-poll",),
            command=(
                "GOCACHE=/tmp/go-build go run ./cmd/serve-manager dashboard "
                "--listen 127.0.0.1:9092 "
                "--stats .runtime/serve-manager/stats/llama-server.json"
            ),
        ),
        "llama-swap": Service(
            name="llama-swap",
            window="swap",
            description="generate llama-swap config and run the hot-swap proxy",
            command=(
                "mkdir -p .runtime/tmux/generated "
                "&& ./llama-swap-runner.py config --output .runtime/tmux/generated/llama-swap.yaml "
                "&& ./llama-swap-runner.py start "
                "--config .runtime/tmux/generated/llama-swap.yaml "
                "--listen 127.0.0.1:8080 "
                "--watch-config"
            ),
        ),
        "serve-manager-status": Service(
            name="serve-manager-status",
            window="status",
            description="periodically show serve-manager status",
            command=(
                "while true; do "
                "clear; "
                "date; "
                "GOCACHE=/tmp/go-build go run ./cmd/serve-manager status; "
                "sleep 5; "
                "done"
            ),
        ),
        "sampler-proxy": Service(
            name="sampler-proxy",
            window="sampler",
            description="inject sampler defaults (repetition_penalty) in front of the :8001 worker",
            env={
                "UPSTREAM": "http://127.0.0.1:8001",
                "LISTEN": "127.0.0.1:8002",
                "REPETITION_PENALTY": "1.15",
            },
            command="./support/sampler-proxy",
        ),
        "core": ("stats-poll", "dashboard", "serve-manager-status"),
        "direct": ("model:qwen36-27b-mtp-ud-q5k-xl", "stats-poll", "dashboard", "serve-manager-status"),
        "observability": ("stats-poll", "dashboard"),
        "manager": ("stats-poll", "dashboard", "serve-manager-status"),
        "swap": ("llama-swap", "stats-poll", "dashboard", "serve-manager-status"),
        "all": ("llama-swap", "stats-poll", "dashboard", "serve-manager-status"),
    }
    for slug in model_slugs():
        members: list[str] = [f"model:{slug}"]
        if is_mlx_model(slug):
            members.append("sampler-proxy")
        if supports_llama_server_observability(slug):
            members += ["stats-poll", "dashboard"]
        services[slug] = tuple(members)
    return services


def model_slugs() -> list[str]:
    slugs: list[str] = []
    for path in sorted((ROOT / "models").glob("*.json")):
        try:
            data = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        slug = data.get("model", {}).get("slug")
        if isinstance(slug, str) and slug:
            slugs.append(slug)
    return slugs


def is_mlx_model(slug: str) -> bool:
    """True if the sidecar for ``slug`` is an MLX artifact (needs the sampler proxy)."""
    return model_artifact_format(slug) == "mlx"


def supports_llama_server_observability(slug: str) -> bool:
    """True when the model backend provides llama-server's /metrics and /slots APIs."""
    return model_artifact_format(slug) == "gguf"


def model_artifact_format(slug: str) -> str:
    for path in sorted((ROOT / "models").glob("*.json")):
        try:
            data = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        if data.get("model", {}).get("slug") == slug:
            return (data.get("artifact", {}).get("format") or "").lower()
    return ""


def model_service(slug: str) -> Service:
    port = "8001"
    safe = safe_name(slug)
    recommended_env = model_recommended_env(slug)
    env = {
        "MODEL_SLUG": slug,
        "HOST": "127.0.0.1",
        "PORT": port,
        "RUN_MODE": "direct",
    }
    if recommended_env.get("LLAMA_SERVER_BIN"):
        env["LLAMA_SERVER_BIN"] = recommended_env["LLAMA_SERVER_BIN"]
    return Service(
        name=f"model:{slug}",
        window=f"model-{safe}"[:32],
        description=f"run direct worker for model slug {slug}",
        env=env,
        command=f"./support/model-service {shell_quote(slug)} {shell_quote(port)}",
    )


def model_recommended_env(slug: str) -> dict[str, str]:
    for path in sorted((ROOT / "models").glob("*.json")):
        try:
            data = json.loads(path.read_text())
        except json.JSONDecodeError:
            continue
        if data.get("model", {}).get("slug") != slug:
            continue
        recommended_env = data.get("launcher", {}).get("recommended_env", {})
        if isinstance(recommended_env, dict):
            return {
                str(key): str(value)
                for key, value in recommended_env.items()
                if isinstance(key, str) and value is not None
            }
    return {}


def resolve_target(target: str, registry: dict[str, Service | tuple[str, ...]]) -> Plan:
    seen: set[str] = set()
    ordered: list[Service] = []

    def visit(name: str) -> None:
        if name in seen:
            return
        seen.add(name)
        if name.startswith("model:"):
            ordered.append(model_service(name.removeprefix("model:")))
            return
        entry = registry.get(name)
        if entry is None:
            raise KeyError(name)
        if isinstance(entry, Service):
            for dep in entry.deps:
                visit(dep)
            ordered.append(entry)
            return
        for dep in entry:
            visit(dep)

    visit(target)
    return Plan(target=target, services=tuple(ordered))


def print_targets(registry: dict[str, Service | tuple[str, ...]]) -> None:
    slugs = model_slugs()
    slug_set = set(slugs)
    sets = sorted(
        name
        for name, entry in registry.items()
        if isinstance(entry, tuple) and name not in slug_set
    )
    services = sorted(name for name, entry in registry.items() if isinstance(entry, Service))
    if use_tui():
        assert console is not None and Table is not None and Panel is not None and box is not None
        table = Table(title="lm-based targets", box=box.SIMPLE_HEAVY)
        table.add_column("Kind", style="cyan", no_wrap=True)
        table.add_column("Name", style="bold")
        table.add_column("Description")
        for name in sets:
            table.add_row("set", name, service_set_description(name))
        for name in services:
            service = registry[name]
            assert isinstance(service, Service)
            table.add_row("service", name, service.description)
        for slug in slugs:
            table.add_row("model", slug, model_target_description(slug))
        console.print(Panel(table, title="Available ./up Targets", border_style="cyan"))
        return

    print("service sets:")
    for name in sets:
        print(f"  {name}")
    print("\nservices:")
    for name in services:
        service = registry[name]
        assert isinstance(service, Service)
        print(f"  {name:22s} {service.description}")
    print("\nmodel slugs:")
    for slug in slugs:
        print(f"  {slug:38s} {model_target_description(slug)}")


def print_plan(plan: Plan, session: str) -> None:
    if use_tui():
        assert console is not None and Table is not None and Panel is not None and box is not None
        table = Table(box=box.SIMPLE_HEAVY)
        table.add_column("Window", style="cyan", no_wrap=True)
        table.add_column("Service", style="bold")
        table.add_column("Description")
        for service in plan.services:
            table.add_row(
                service.window_name,
                service.name,
                service.description,
            )
        console.print(
            Panel(
                table,
                title=f"Plan: ./up {plan.target}",
                subtitle=f"tmux session: {session}",
                border_style="green",
            )
        )
        return

    print(f"session: {session}")
    print(f"target:  {plan.target}")
    for service in plan.services:
        command = service_command(service)
        print(f"\n[{service.window_name}] {service.name}")
        print(f"  {service.description}")
        print(f"  {command}")


def print_ensured(plan: Plan, session: str, actions: dict[str, str]) -> None:
    pi_hint = plan_pi_hint(plan)
    if use_tui():
        assert console is not None and Table is not None and Panel is not None and box is not None
        table = Table(box=box.SIMPLE_HEAVY)
        table.add_column("State", style="green", no_wrap=True)
        table.add_column("Window", style="cyan", no_wrap=True)
        table.add_column("Service", style="bold")
        table.add_column("Description")
        for service in plan.services:
            table.add_row(actions[service.name], service.window_name, service.name, service.description)
        console.print(
            Panel(
                table,
                title=f"tmux session: {session}",
                subtitle=pi_hint or f"attach: tmux attach -t {session}",
                border_style="green",
            )
        )
        if pi_hint:
            console.print(f"attach: tmux attach -t {session}")
        return

    print(f"tmux session: {session}")
    print("service windows:")
    for service in plan.services:
        print(f"  {actions[service.name]:9s} {service.window_name:32s} {service.description}")
    if pi_hint:
        print(pi_hint)
    print(f"attach: tmux attach -t {session}")


def plan_pi_hint(plan: Plan) -> str | None:
    if any(service.name.startswith("model:") or service.name == "llama-swap" for service in plan.services):
        return "agent: ./pi-local"
    return None


def print_error(message: str) -> None:
    if use_tui():
        assert console is not None
        console.print(f"[bold red]error:[/] {message}", file=sys.stderr)
    else:
        print(f"error: {message}", file=sys.stderr)


def service_command(service: Service) -> str:
    env = " ".join(f"{key}={value}" for key, value in service.env.items())
    return f"{env} {service.command}".strip()


def service_set_description(name: str) -> str:
    return {
        "core": "core services: stats, dashboard, status",
        "direct": "default direct model worker plus core services",
        "observability": "stats and dashboard only",
        "manager": "core manager-facing services",
        "swap": "llama-swap plus core services",
        "all": "all currently managed service windows",
    }.get(name, "")


def model_target_description(slug: str) -> str:
    if is_mlx_model(slug):
        return "direct MLX worker plus sampler proxy"
    if supports_llama_server_observability(slug):
        return "direct llama-server worker plus observability"
    return "direct model worker"


def use_tui() -> bool:
    return console is not None and sys.stdout.isatty()


def ensure_session(session: str) -> None:
    if not session_exists(session):
        shell = os.environ.get("SHELL") or "/bin/sh"
        run_tmux(["new-session", "-d", "-s", session, "-n", "control", shell, "-l"])


def reconcile_windows(session: str, plan: Plan) -> None:
    desired = {"control", *(service.window_name for service in plan.services)}
    for name, state in window_states(session).items():
        if name not in desired:
            terminate_process_group(state.pid)
            run_tmux(["kill-window", "-t", f"{session}:{name}"])


def start_service(session: str, service: Service, restart: bool) -> str:
    target = f"{session}:{service.window_name}"
    state = window_states(session).get(service.window_name)
    if state is not None and not state.dead and not restart:
        run_tmux(["set-window-option", "-t", target, "remain-on-exit", "on"])
        return "kept"

    env_prefix = " ".join(f"{key}={shell_quote(value)}" for key, value in service.env.items())
    command = f"{env_prefix} {service.command}".strip()
    shim_command = (
        f"exec env LM_BASED_ROOT={shell_quote(str(ROOT))} "
        f"LM_BASED_TMUX_SESSION={shell_quote(session)} "
        f"{shell_quote(str(SHIM))} {shell_quote(service.name)} -- "
        f"bash -lc {shell_quote(command)}"
    )
    if state is not None:
        run_tmux(["set-window-option", "-t", target, "remain-on-exit", "on"])
        run_tmux(["respawn-window", "-k", "-t", target, shim_command])
        return "restarted"
    run_tmux(["new-window", "-d", "-t", session, "-n", service.window_name, shim_command])
    run_tmux(["set-window-option", "-t", target, "remain-on-exit", "on"])
    return "started"


def stop_session(session: str) -> int:
    states = window_states(session)
    service_pids = {state.pid for name, state in states.items() if name != "control" and not state.dead}
    service_pids.update(registered_service_pids(session).values())
    for pid in sorted(service_pids):
        terminate_process_group(pid)
    if session_exists(session):
        run_tmux(["kill-session", "-t", session])
    print(f"tmux session {session}: stopped")
    return 0


def print_status(session: str) -> int:
    states = window_states(session)
    registered = registered_service_pids(session)
    if not states:
        if not registered:
            print(f"tmux session {session}: stopped")
            return 0
        print(f"tmux session {session}: stopped (orphaned services detected)")
        for service, pid in registered.items():
            print(f"  orphaned {service:32s} pid={pid}")
        return 1
    print(f"tmux session {session}: running")
    for state in states.values():
        service_state = "exited" if state.dead else "running"
        pid = "-" if state.dead else str(state.pid)
        print(f"  {service_state:7s} {state.name:32s} pid={pid}")
    active_pids = {state.pid for state in states.values() if not state.dead}
    orphaned = {service: pid for service, pid in registered.items() if pid not in active_pids}
    for service, pid in orphaned.items():
        print(f"  orphaned {service:32s} pid={pid}")
    return 1 if orphaned else 0


def session_exists(session: str) -> bool:
    return tmux_ok(["has-session", "-t", session])


def window_states(session: str) -> dict[str, WindowState]:
    result = subprocess.run(
        ["tmux", "list-windows", "-t", session, "-F", "#{window_name}|#{pane_dead}|#{pane_pid}"],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        return {}
    states: dict[str, WindowState] = {}
    for line in result.stdout.splitlines():
        fields = line.split("|", 2)
        if len(fields) != 3:
            continue
        name, dead, pid_value = fields
        try:
            pid = int(pid_value)
        except ValueError:
            continue
        states[name] = WindowState(name=name, dead=dead == "1", pid=pid)
    return states


def registered_service_pids(session: str) -> dict[str, int]:
    services_dir = RUNTIME / "services"
    if not services_dir.is_dir():
        return {}
    registered: dict[str, int] = {}
    for path in sorted(services_dir.glob("*/shim.pid")):
        session_path = path.parent / "session"
        try:
            registered_session = session_path.read_text().strip()
        except OSError:
            registered_session = SESSION
        if registered_session != session:
            continue
        try:
            pid = int(path.read_text().strip())
        except (OSError, ValueError):
            continue
        if is_managed_shim(pid):
            registered[path.parent.name] = pid
    return registered


def is_managed_shim(pid: int) -> bool:
    result = subprocess.run(
        ["ps", "-p", str(pid), "-o", "command="],
        text=True,
        capture_output=True,
    )
    return result.returncode == 0 and str(SHIM) in result.stdout


def terminate_process_group(pid: int, timeout: float = 5.0) -> None:
    if pid <= 0:
        return
    try:
        pgid = os.getpgid(pid)
    except ProcessLookupError:
        return
    if pgid != pid or not is_managed_shim(pid):
        return
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.05)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def tmux_ok(args: list[str]) -> bool:
    result = subprocess.run(["tmux", *args], text=True, capture_output=True)
    return result.returncode == 0


def run_tmux(args: list[str]) -> None:
    subprocess.run(["tmux", *args], check=True)


def shell_quote(value: str) -> str:
    return "'" + value.replace("'", "'\"'\"'") + "'"


def safe_name(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]+", "-", value).strip("-")


if __name__ == "__main__":
    raise SystemExit(main())
